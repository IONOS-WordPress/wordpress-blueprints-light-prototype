{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Structure of the deactivate_plugin task payload.",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique id of this task.",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "description": "The type of this task.",
      "const": "deactivate_plugin"
    },
    "args" : {
      "type": "object",
      "properties" : {
        "slug": {
          "type": "string",
          "description": "The slug of the wordpress plugin to deactivate."
        },
        "silent": {
          "type": "boolean",
          "default": false,
          "description": "Prevent calling deactivation hooks. Default false."
        }
      },
      "required": ["slug"]
    }
  },
  "required": ["args", "type", "id"]
}