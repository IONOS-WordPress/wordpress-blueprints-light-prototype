{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Structure of the get_option task payload.",
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique id of this task.",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "description": "The type of this task.",
      "const": "set_option"
    },
    "args" : {
      "type": "object",
      "properties" : {
        "name": {
          "type": "string",
          "description": "The name of the wordpress option to get."
        }
      },
      "required": ["name"]
    }
  },
  "required": ["args", "id", "type"]
}